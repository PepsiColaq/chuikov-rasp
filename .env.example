# Скопируй в .env.local и заполни (файл .env.local не коммитится)
VITE_SUPABASE_URL=https://XXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Опционально: Cloudflare Worker-прокси (лучше с VPN / обходом DPI)
# После деплоя workers/ (см. workers/wrangler.toml) подставь URL Worker:
# VITE_SUPABASE_URL=https://rasp-supabase-proxy.XXXX.workers.dev
# или:
# VITE_SUPABASE_PROXY_URL=https://rasp-supabase-proxy.XXXX.workers.dev

# Только для скрипта заливки (не класть в GitHub Pages!)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
